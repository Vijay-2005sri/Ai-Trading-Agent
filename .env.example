# ==============================================
# MT5 Credentials (XM Broker)
# ==============================================
MT5_LOGIN=your_account_number
MT5_PASSWORD=your_mt5_password
MT5_SERVER=XMGlobal-MT5
MT5_PATH="C:\Program Files\XM MT5\terminal64.exe"
MT5_DEMO=true

# ==============================================
# LLM PROVIDERS — The "Brain"
# Priority: Groq (free) → Gemini (free) → OpenRouter (free) → OpenAI (paid)
# You only need ONE key to start. More = better failover.
# ==============================================

# 🥇 GROQ — FREE, blazing fast (~1000 req/day)
# Get key at: https://console.groq.com
GROQ_API_KEY=gsk_...

# 🥈 GOOGLE GEMINI — FREE (~1500 req/day)
# Get key at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=AIza...

# 🥉 OPENROUTER — FREE tier (50-1000 req/day)
# Get key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# 💰 OPENAI — PAID fallback (only used if all free providers are down)
OPENAI_API_KEY=sk-...

# ==============================================
# SEARCH / WEB ACCESS
# ==============================================
# Tavily is optional. DuckDuckGo is used as free default.
TAVILY_API_KEY=tvly-...
